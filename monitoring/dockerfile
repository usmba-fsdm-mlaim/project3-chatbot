FROM ubuntu:22.04

# Avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    wget \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Prometheus
RUN wget https://github.com/prometheus/prometheus/releases/download/v2.48.0/prometheus-2.48.0.linux-amd64.tar.gz && \
    tar -xzf prometheus-2.48.0.linux-amd64.tar.gz && \
    mv prometheus-2.48.0.linux-amd64 /opt/prometheus && \
    rm prometheus-2.48.0.linux-amd64.tar.gz && \
    mkdir -p /etc/prometheus /var/lib/prometheus

# Install Grafana
RUN wget https://dl.grafana.com/oss/release/grafana-10.2.3.linux-amd64.tar.gz && \
    tar -xzf grafana-10.2.3.linux-amd64.tar.gz && \
    mv grafana-v10.2.3 /opt/grafana && \
    rm grafana-10.2.3.linux-amd64.tar.gz && \
    mkdir -p /var/lib/grafana /var/log/grafana

# Copy configuration files
COPY prometheus/prometheus.yml /etc/prometheus/prometheus.yml
COPY prometheus/alerts.yml /etc/prometheus/alerts.yml
COPY grafana/provisioning /etc/grafana/provisioning

# Configure Grafana
RUN echo "[server]" > /opt/grafana/conf/defaults.ini && \
    echo "http_port = 3001" >> /opt/grafana/conf/defaults.ini && \
    echo "[security]" >> /opt/grafana/conf/defaults.ini && \
    echo "admin_password = admin" >> /opt/grafana/conf/defaults.ini && \
    echo "[paths]" >> /opt/grafana/conf/defaults.ini && \
    echo "data = /var/lib/grafana" >> /opt/grafana/conf/defaults.ini && \
    echo "logs = /var/log/grafana" >> /opt/grafana/conf/defaults.ini && \
    echo "provisioning = /etc/grafana/provisioning" >> /opt/grafana/conf/defaults.ini

# Setup supervisor to run both services
RUN mkdir -p /var/log/supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create necessary directories with proper permissions
RUN mkdir -p /var/lib/grafana /var/log/grafana /etc/grafana/provisioning && \
    chmod -R 777 /var/lib/grafana /var/log/grafana

# Expose ports
EXPOSE 9090 3003

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
